<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="219dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView_challenge_drill_marker"
            android:layout_width="140dp"
            android:layout_height="113dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:visibility="invisible"
            app:srcCompat="@drawable/correct" />

        <TextView
            android:id="@+id/textView_challenge_drill_marker_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Marker"
            android:textSize="24sp"
            android:visibility="invisible" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_challenge_drill_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:text="Word"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="216dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/button_challenge_drill_play"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:background="@drawable/bg_text2"

            android:contentDescription="Play pronunciation"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/speaker" />

        <ImageButton
            android:id="@+id/button_challenge_drill_record"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:background="@drawable/bg_text2"
            android:contentDescription="Record pronunciation"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/microphone" />
    </LinearLayout>
</LinearLayout>