<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="219dp"
      android:orientation="vertical">

    <ImageView
        android:id="@+id/imageView_challenge_question_marker"
        android:layout_width="140dp"
        android:layout_height="113dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="invisible"
        app:srcCompat="@drawable/correct" />

    <TextView
        android:id="@+id/textView_challenge_question_marker_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Marker"
        android:textSize="24sp"
        android:visibility="invisible" />

  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="220dp"
      android:orientation="vertical">

    <TextView
        android:id="@+id/textView_challenge_question_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:text="Word"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editText_challenge_question_input"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:ems="10"
        android:hint="Type in the English translation"
        android:inputType="text|textMultiLine" />

    <TextView
        android:id="@+id/textView_challenge_question_answer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Checking..."
        android:textSize="16sp"
        android:visibility="invisible" />

  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="84dp"
      android:orientation="horizontal">


    <Button
        android:id="@+id/button_challenge_question_check"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_text2"
        android:text="Check"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <Button
        android:id="@+id/button_challenge_question_next"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_text2"
        android:text="Next"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp" />
  </LinearLayout>
</LinearLayout>