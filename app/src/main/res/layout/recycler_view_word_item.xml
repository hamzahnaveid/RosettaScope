<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/word_item_layout">

    <ImageView
        android:id="@+id/imageView_word_status"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/avatars" />

    <TextView
        android:id="@+id/textView_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="20dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/imageView_word_status"
        app:layout_constraintTop_toTopOf="@+id/imageView_word_status"
        tools:text="Word" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
        android:layout_width="214dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:max="100"
        android:paddingBottom="4dp"
        android:progress="0"
        android:progressTint="#28B306"
        android:scaleY="2"
        app:layout_constraintBottom_toTopOf="@+id/textView_word"
        app:layout_constraintStart_toEndOf="@+id/imageView_word_status" />

    <TextView
        android:id="@+id/textView_mastery_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:text="Mastery Level"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView_word_status"
        app:layout_constraintTop_toBottomOf="@+id/textView_word" />

    <ImageView
        android:id="@+id/imageView_arrow_to_word"
        android:layout_width="36dp"
        android:layout_height="37dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="23dp"
        android:rotation="-90"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/imageView_word_status"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/m3_split_button_chevron_avd" />

</androidx.constraintlayout.widget.ConstraintLayout>